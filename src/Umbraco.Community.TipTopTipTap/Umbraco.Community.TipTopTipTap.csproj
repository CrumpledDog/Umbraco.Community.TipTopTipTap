<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
    <NoWarn>$(NoWarn);NU5118;NU1902;NU1903</NoWarn>

    <!-- Symbol file configuration -->
    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Deterministic build configuration -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Umbraco.Community.TipTopTipTap</PackageId>
    <Product>Umbraco.Community.TipTopTipTap</Product>
    <Title>Crumpled Package Template</Title>
    <Description>TODO: describe what Umbraco.Community.TipTopTipTap does.</Description>
    <PackageTags>umbraco plugin package umbraco-marketplace</PackageTags>
    <RootNamespace>Umbraco.Community.TipTopTipTap</RootNamespace>
    <Authors>Crumpled Dog</Authors>
    <PackageProjectUrl>https://github.com/CrumpledDog/Umbraco.Community.TipTopTipTap</PackageProjectUrl>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageVersion>$(PackageVersion)</PackageVersion>
    <Version>$(PackageVersion)</Version>
    <InformationalVersion>$(PackageVersion)</InformationalVersion>
  </PropertyGroup>

  <!-- Central package management - no versions -->
  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Api.Common" />
    <PackageReference Include="Umbraco.Cms.Api.Management" />
    <PackageReference Include="Umbraco.Cms.Web.Common" />
    <PackageReference Include="Umbraco.Cms.Web.Website" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />

    <!--
      Microsoft.AspNetCore.OpenApi is available transitively from the Umbraco packages above, but we take a
      direct dependency here because extension code directly uses types from it and from Microsoft.OpenApi
      (OpenApiInfo) - both OpenApiRegistration.Umbraco17.cs and .Umbraco18.cs need this pinned to the .NET
      runtime's own version rather than left to NuGet's transitive resolution, or the different
      Microsoft.OpenApi versions can conflict at runtime and cause the custom OpenAPI document to not appear.
    -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>

  <!-- Only one of these two files is ever compiled - see the comment atop each. -->
  <ItemGroup Condition="'$(UmbracoTargetMajor)' == '17'">
    <Compile Remove="Composers\OpenApiRegistration.Umbraco18.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(UmbracoTargetMajor)' == '18'">
    <Compile Remove="Composers\OpenApiRegistration.Umbraco17.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Don't include the client folder as part of packaging nuget build -->
    <Content Remove="Client\**" />

    <!-- However make the Umbraco-package.json included for dotnet pack or nuget package and visible to the solution -->
    <None Include="Client\public\umbraco-package.json" Pack="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../LICENSE" Pack="true" PackagePath="" />
    <None Include="../../README.md" Pack="true" PackagePath="" />
    <None Include="../../icons/icon.png" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Umbraco.Community.TipTopTipTap.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>

</Project>
