<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
    <NoWarn>$(NoWarn);NU5118;NU1902;NU1903</NoWarn>

    <!-- Symbol file configuration -->
    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Deterministic build configuration -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Umbraco.Community.TipTopTipTap</PackageId>
    <Product>Umbraco.Community.TipTopTipTap</Product>
    <Title>TipTopTipTap</Title>
    <Description>A Rich Text Editor (TipTap) extension for Umbraco that cleans up the debris Word/Office paste leaves behind - empty class="" and style="" attributes, and meaningless empty span marks - layered on top of @intevation/tiptap-extension-office-paste's own mso-style and list cleanup.</Description>
    <PackageTags>umbraco plugin package umbraco-marketplace tiptap rte richtext office-paste word-paste</PackageTags>
    <RootNamespace>Umbraco.Community.TipTopTipTap</RootNamespace>
    <Authors>Crumpled Dog</Authors>
    <PackageProjectUrl>https://github.com/CrumpledDog/Umbraco.Community.TipTopTipTap</PackageProjectUrl>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageVersion>$(PackageVersion)</PackageVersion>
    <Version>$(PackageVersion)</Version>
    <InformationalVersion>$(PackageVersion)</InformationalVersion>
  </PropertyGroup>

  <!--
    Central package management - no versions. This package ships zero backend C# logic (it's a pure
    Client/ backoffice UI extension - see the TipTap office-paste cleanup extension under Client/src/tiptap),
    so it only needs Umbraco.Cms.Web.Common: the Microsoft.NET.Sdk.Razor RCL still needs it to correctly
    ship App_Plugins static web assets as part of an Umbraco package. There's no Management API, so
    Umbraco.Cms.Api.Common/Api.Management/Microsoft.AspNetCore.OpenApi are intentionally not referenced.
  -->
  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Web.Common" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <!-- Don't include the client folder as part of packaging nuget build -->
    <Content Remove="Client\**" />

    <!-- However make the Umbraco-package.json included for dotnet pack or nuget package and visible to the solution -->
    <None Include="Client\public\umbraco-package.json" Pack="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../LICENSE" Pack="true" PackagePath="" />
    <None Include="../../README.md" Pack="true" PackagePath="" />
    <None Include="../../icons/icon.png" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Umbraco.Community.TipTopTipTap.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>

</Project>
