  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "watch": "tsc && vite build --watch",
    "build": "tsc && vite build"
  },
  "devDependencies": {
    "@umbraco-cms/backoffice": "17.5.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@intevation/tiptap-extension-office-paste": "^0.1.2"
  },
  "overrides": {
